SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=

# GitHub 成功登入授權後轉的網址。請只改兩個項目：
#   1. http 或 https
#   2. your_domain 改成自己的 domain，例如 www.xxx.com 或是 localhost:3000 等。
GITHUB_CALLBACK_URI=https://your_domain/auth/github/callback

# 用於 JWT 授權，可以使用預設的或是設定自己的。
FASTIFY_AUTH_JWT_SECRET=dilab-notebook-paradise-api-token-with-at-least-32-characters-long
# 使用的 JWT 加密演算法。沒必要換的話可以用預設的。
JWT_ALGORITHM=HS256
# Token 有效時間預設一小時（60 * 60）。
JWT_EXP_DELTA_SECONDS=3600

# 在 production 的時候，要用正式的 domain name。
FRONT_APP_BASE_URL=http://localhost:5173/

# 使用者上傳的網站類筆記的儲存路徑。
USER_WEBPAGE_NOTE_UPLOAD_SAVE_PATH=

# 使用者上傳的筆記的(無做處理)備份資料夾。
USER_UPLOAD_BACKUP_PATH=
